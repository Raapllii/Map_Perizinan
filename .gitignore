# Dependencies
/node_modules
/vendor

# Environment & Secrets
.env
.env.backup
.env.production
*.key

# Laravel Storage & Cache
/storage/*.key
/storage/app/backups/*
!/storage/app/backups/.gitignore
/storage/app/imports/*
!/storage/app/imports/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/cache/laravel-excel/*
!/storage/framework/cache/laravel-excel/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/public/storage
/public/hot

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Raw Data, Spreadsheet Dumps & Database Backups (Privacy & Security)
*.csv
*.xlsx
*.xls
~$*.xlsx
~$*.xls
*.sql
*.dump
*.tar.gz

# Temporary & Build/Cache Files
.phpunit.result.cache
composer.phar
composer-setup.php
*.bak
*.tmp
*.temp
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker & Homestead Local Configs
docker-compose.override.yml
Homestead.json
Homestead.yaml
